# Copy this to .env and fill in your keys

# Optional — if not set, agent uses local claude CLI (already authenticated via Claude Code)
# ANTHROPIC_API_KEY=your_anthropic_key_here
TAVILY_API_KEY=tvly-your_tavily_key_here

# Overmind tracing — all LLM calls traced automatically
OVERMIND_API_KEY=

# Optional: Cursor will use this too
OPENAI_API_KEY=
